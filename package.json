{
  "name": "agent-reliability-kit",
  "version": "0.0.0",
  "private": true,
  "description": "A reliability layer for AI agent products: sanitize, classify, policy, report.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MosslandOpenDevs/agent-reliability-kit.git"
  },
  "homepage": "https://github.com/MosslandOpenDevs/agent-reliability-kit#readme",
  "bugs": {
    "url": "https://github.com/MosslandOpenDevs/agent-reliability-kit/issues"
  },
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm run build && pnpm -r --filter \"./packages/*\" run test",
    "test:only": "pnpm -r --filter \"./packages/*\" run test",
    "schema:validate": "node scripts/validate-schema.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run schema:validate && pnpm run test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
