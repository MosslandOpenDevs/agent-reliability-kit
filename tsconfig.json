{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@ark/core": ["./packages/core/src/index.ts"],
      "@ark/sanitize": ["./packages/sanitize/src/index.ts"],
      "@ark/classify": ["./packages/classify/src/index.ts"],
      "@ark/policy": ["./packages/policy/src/index.ts"],
      "@ark/report": ["./packages/report/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "examples/**/*.ts",
    "scripts/**/*.mjs"
  ]
}
